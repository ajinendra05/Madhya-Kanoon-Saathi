# Copy to .env and fill in locally. Never commit .env. In production these come from SSM Parameter Store (DEC-009).
# Names only — no values here.

# LLM providers
SARVAM_API_KEY=
BEDROCK_FALLBACK_MODEL_ID=
BEDROCK_JUDGE_MODEL_ID=

# Telegram (DEC-007, DEC-010)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# AWS (use a named profile; never put access keys here)
AWS_PROFILE=
AWS_REGION=ap-south-1

# GitHub token for law-watch issues (DEC-013) — fine-grained, issues:write on this repo only
GITHUB_TOKEN=

# Local paths
MKS_DATA_DIR=./data
