{
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run python *)",
      "Bash(uv sync --locked *)",
      "Bash(uv sync --frozen *)",
      "Bash(pre-commit run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)"
    ],
    "ask": [
      "Edit(/docs/DECISIONS.md)",
      "Edit(/docs/CORPUS.md)",
      "Bash(uv run pytest -m paid *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock *)",
      "Bash(uv pip *)",
      "Bash(pip *)",
      "Bash(git push *)",
      "Bash(git branch *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git rm *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(gh repo create *)",
      "Bash(gh *)",
      "Bash(rm *)",
      "Bash(terraform init *)",
      "Bash(terraform plan *)",
      "Bash(terraform apply *)",
      "Bash(terraform import *)",
      "Bash(terraform state *)",
      "Bash(aws *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(git push *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.tfvars)",
      "Read(~/.aws/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(terraform destroy *)",
      "Bash(printenv *)",
      "Bash(env)",
      "PowerShell(Remove-Item * -Recurse *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_checks.py\"",
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/progress_summary.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
